[Unit]
Description=Unbound Dashboard API (v1 modernization — FastAPI)
Documentation=file:///var/www/html/unbound-dashboard/docs/PLANO_MODERNIZACAO_V1.md
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/unbound-dashboard/api_service
EnvironmentFile=/etc/unbound-dashboard/api-v1.env
ExecStart=/var/www/html/unbound-dashboard/api_service/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
# NoNewPrivileges=no — o pipeline de self-update via UI spawna `sudo bash
# tools/update.sh ...` (sudoers permite www-data NOPASSWD, ver
# system/sudoers/unbound-dashboard). NoNewPrivileges=yes bloqueia sudo
# porque sudo precisa do bit setuid root pra escalar privilege. Sem
# self-update, voltar pra yes ganha um pouco de hardening (mas perde
# a feature).
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes

# Caminhos onde o serviço pode escrever.
#
# Self-update via UI: o api_service spawna `sudo bash update.sh ...` que
# escreve em vários paths do sistema. O subprocess herda o namespace
# mount do api_service (ProtectSystem=strict), então todos esses paths
# precisam estar listados — caso contrário update.sh falha silenciosamente
# em rm/cp/tar.
ReadWritePaths=/var/lib/unbound-dashboard
ReadWritePaths=/var/log/unbound-dashboard
ReadWritePaths=/var/www/html/unbound-dashboard
ReadWritePaths=/var/backups/unbound-dashboard
ReadWritePaths=/etc/sudoers.d
ReadWritePaths=/etc/systemd/system
ReadWritePaths=/etc/apache2
ReadWritePaths=/etc/php
ReadWritePaths=/etc/unbound-dashboard
ReadWritePaths=/usr/local/bin
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
