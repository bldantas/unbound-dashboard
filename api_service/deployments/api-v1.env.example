# Template do EnvironmentFile do systemd unit unbound-dashboard-api.service.
# Copiar para /etc/unbound-dashboard/api-v1.env (chmod 640, owner root:www-data).
#
# Para gerar JWT_SECRET seguro:
#   openssl rand -hex 32

# JWT — OBRIGATÓRIO substituir CHANGE_ME (validator falha no startup se ficar)
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# DuckDB
DB_PATH=/var/lib/unbound-dashboard/unbound_dash.duckdb

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Unbound
UNBOUND_CONTROL=/usr/sbin/unbound-control
UNBOUND_LOG=/var/log/unbound/unbound.log

# App
LOG_LEVEL=INFO
DEBUG=false

# CORS — Apache faz proxy, então frontend e API ficam no mesmo origin (geralmente sem CORS).
# Para origens específicas use CSV: CORS_ORIGINS=https://a.exemplo,https://b.exemplo
# Linha comentada = lista vazia (default).
# CORS_ORIGINS=

# Rate limiting
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AUTH=10/minute

# GitHub token — OPCIONAL (repo unbound-dashboard é público desde 2026-05-14).
# Em repo público, pode deixar vazio — /api/v1/updates/check consulta releases
# anonimamente (rate limit GitHub: 60 req/h por IP, suficiente pro worker
# update_checker que roda a cada 6h).
# Em repo privado, é obrigatório — gere um Fine-grained PAT em
# github.com/settings/tokens (escopo "Contents: Read" do repo) ou use
# `gh auth token` se o token do `gh` CLI tiver `repo` scope.
GITHUB_TOKEN=
