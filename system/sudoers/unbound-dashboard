# Unbound Dashboard — sudoers (source of truth versionada)
#
# Instalado em /etc/sudoers.d/unbound-dashboard pelo install.sh.
# Cada vírgula separa um comando atômico permitido a www-data com NOPASSWD.
# Paths absolutos sempre — wildcards limitados ao argumento final.
#
# IMPORTANTE: depois de editar, valide com `visudo -c -f <arquivo>` antes
# de commitar. O install.sh roda essa validação automaticamente.

www-data ALL=(ALL) NOPASSWD: \
    /usr/sbin/unbound-control *, \
    /usr/bin/cp /tmp/unbound_* *, \
    /usr/bin/cp /var/www/html/unbound-dashboard/src/data/tmp/unbound_* *, \
    /usr/sbin/unbound-checkconf *, \
    /usr/sbin/service unbound *, \
    /usr/bin/systemctl * unbound, \
    /usr/sbin/ifdown *, \
    /usr/sbin/ifup *, \
    /usr/bin/mv /tmp/interfaces_new /etc/network/interfaces, \
    /usr/bin/mv /var/www/html/unbound-dashboard/src/data/tmp/interfaces_new /etc/network/interfaces, \
    /usr/bin/mv /tmp/timesyncd.conf.new /etc/systemd/timesyncd.conf, \
    /usr/bin/mv /var/www/html/unbound-dashboard/src/data/tmp/timesyncd.conf.new /etc/systemd/timesyncd.conf, \
    /usr/bin/mv /tmp/resolv_conf_new /etc/resolv.conf, \
    /usr/bin/mv /var/www/html/unbound-dashboard/src/data/tmp/resolv_conf_new /etc/resolv.conf, \
    /usr/bin/systemctl restart systemd-timesyncd, \
    /usr/bin/timedatectl set-timezone *, \
    /usr/bin/hostnamectl set-hostname *, \
    /usr/bin/tail -n 300 /var/log/syslog, \
    /usr/bin/tail -n 300 /var/log/unbound.log, \
    /usr/bin/tail -n 300 /var/log/unbound/unbound.log, \
    /usr/bin/journalctl -u unbound -n 300 --no-pager, \
    /usr/local/bin/unbound-health-fix.sh, \
    /usr/sbin/netplan apply, \
    /usr/sbin/netplan generate, \
    /usr/bin/mv /tmp/unbound-dashboard-netplan.yaml /etc/netplan/99-unbound-dashboard.yaml, \
    /usr/bin/mv /var/www/html/unbound-dashboard/src/data/tmp/unbound-dashboard-netplan.yaml /etc/netplan/99-unbound-dashboard.yaml, \
    /usr/bin/cp /etc/netplan/99-unbound-dashboard.yaml /var/backups/unbound-dashboard/netplan-99-*.yaml, \
    /usr/bin/cp /var/backups/unbound-dashboard/netplan-99-*.yaml /etc/netplan/99-unbound-dashboard.yaml, \
    /usr/bin/rm /etc/netplan/99-unbound-dashboard.yaml, \
    /usr/bin/mv /var/www/html/unbound-dashboard/src/data/tmp/resolved.conf.new /etc/systemd/resolved.conf, \
    /usr/bin/systemctl restart systemd-resolved, \
    /usr/bin/mv /var/www/html/unbound-dashboard/src/data/tmp/hosts.new /etc/hosts, \
    /usr/bin/mv /var/www/html/unbound-dashboard/src/data/tmp/chrony.conf.new /etc/chrony/chrony.conf, \
    /usr/bin/mv /var/www/html/unbound-dashboard/src/data/tmp/chrony.conf.new /etc/chrony.conf, \
    /usr/bin/mv /var/www/html/unbound-dashboard/src/data/tmp/ntp.conf.new /etc/ntp.conf, \
    /usr/bin/systemctl restart chrony, \
    /usr/bin/systemctl restart chronyd, \
    /usr/bin/systemctl restart ntp, \
    /usr/bin/systemctl restart ntpd, \
    /usr/bin/systemctl restart ntpsec, \
    /usr/bin/bash /var/www/html/unbound-dashboard/tools/run-update.sh * /var/lib/unbound-dashboard/updates/unbound-dashboard-update-v[0-9]*.tar.gz, \
    /usr/bin/bash /var/www/html/unbound-dashboard/tools/restore-backup.sh * [0-9]*, \
    /usr/bin/systemctl restart unbound-dashboard-api, \
    /usr/bin/mkdir -p /etc/unbound/certs, \
    /usr/bin/install -o unbound -g unbound -m 0644 /var/www/html/unbound-dashboard/src/data/tmp/unbound_dashboard_cert.crt /etc/unbound/certs/dashboard.crt, \
    /usr/bin/install -o unbound -g unbound -m 0640 /var/www/html/unbound-dashboard/src/data/tmp/unbound_dashboard_cert.key /etc/unbound/certs/dashboard.key, \
    /usr/bin/rm /etc/unbound/certs/dashboard.crt, \
    /usr/bin/rm /etc/unbound/certs/dashboard.key, \
    /usr/bin/ls /etc/letsencrypt/live, \
    /usr/bin/ls /etc/letsencrypt/live/, \
    /usr/bin/install -o unbound -g unbound -m 0644 /etc/letsencrypt/live/*/fullchain.pem /etc/unbound/certs/dashboard.crt, \
    /usr/bin/install -o unbound -g unbound -m 0640 /etc/letsencrypt/live/*/privkey.pem /etc/unbound/certs/dashboard.key, \
    /usr/bin/install -o unbound -g unbound -m 0644 /var/www/html/unbound-dashboard/src/data/tmp/unbound_le_lineage /etc/unbound/certs/.le-lineage, \
    /usr/bin/install -m 0755 /var/www/html/unbound-dashboard/system/letsencrypt/unbound-dashboard-deploy.sh /etc/letsencrypt/renewal-hooks/deploy/unbound-dashboard.sh, \
    /usr/bin/bash /var/www/html/unbound-dashboard/tools/setup-apparmor-certs.sh
