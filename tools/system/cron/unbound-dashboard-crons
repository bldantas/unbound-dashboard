# Unbound Dashboard — cron (instalado em /etc/cron.d/unbound-dashboard)
#
# Formato /etc/cron.d: 6ª coluna é o usuário. Roda como www-data — os scripts
# ficam numa árvore que www-data escreve, então rodá-los como root daria root
# a quem controla www-data. Privilégios pontuais vêm do sudoers, como na UI.
#
# Agregação de estatísticas, alertas, ingestão de log e sync de blocklists
# multi-fonte rodam como workers do unbound-dashboard-api.service.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Sincronização da lista judicial ANATEL/Anablock (diário às 04:30)
30 4 * * * www-data /usr/bin/php /var/www/html/unbound-dashboard/src/scripts/sync_judicial_list.php >> /var/log/unbound-dashboard/sync_judicial.log 2>&1
