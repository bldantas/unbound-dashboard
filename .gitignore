# === Banco de dados e arquivos de runtime ===
data/*.db
data/*.sqlite
data/.installed
data/.users_exists_cache
data/tmp/*
!data/tmp/.gitkeep
data/latest_stats.json
data/stats_history.json
data/blocklist_counts.json

# === Arquivos de ambiente ===
.env
!.env.example

# === Build artifacts / pacotes de distribuição ===
dist/*.tar.gz
dist/*.tar.gz.sha256
dist/*.zip
tools/*.tar.gz
tools/*.tar.gz.sha256

# === Pacotes de atualização extraídos ===
unbound-dashboard-update-*/

# === Logs ===
*.log
logs/

# === Dependências PHP ===
vendor/

# === Cache e temporários ===
*.cache
*.tmp
*.lock
# uv.lock do api_service DEVE ser commitado (builds reprodutíveis).
!api_service/uv.lock
src/data/

# === VS Code (opcional, remova se quiser versionar) ===
.vscode/

# === Claude Code (settings locais por máquina) ===
.claude/

# === Sistema operacional ===
.DS_Store
Thumbs.db
